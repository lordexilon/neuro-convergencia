NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56521
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_product_publishable_or_anon_key
GROK_API_KEY=xai-your_grok_api_key_here
GROK_MODEL=grok-2-mini

# Server-only product key; NEVER prefix this with NEXT_PUBLIC_ or use the Matrix key.
SUPABASE_SERVICE_ROLE_KEY=replace_with_product_server_secret_or_service_role_key
# Keep disabled until the quota migration and integration checks are approved.
AI_EXTERNAL_ENABLED=false
AI_USER_WINDOW_SECONDS=600
AI_USER_WINDOW_LIMIT=5
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100

# Operator report only. Leave disabled until cohort consent and read scope are approved.
PILOT_REPORT_ENABLED=false
PILOT_REPORT_PRODUCT_URL=replace_with_verified_product_supabase_url

